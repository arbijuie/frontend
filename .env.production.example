# Public backend origin consumed by browser clients
VITE_ARB_API_URL=https://<app-host-or-domain>

# Optional explicit WS endpoint. If empty, frontend derives it from VITE_ARB_API_URL.
# Example: wss://<app-host-or-domain>/ws/opportunities
VITE_ARB_WS_URL=

# Optional bearer token for compatibility/migration only.
# Warning: VITE_ values are embedded into built frontend assets.
# Prefer Telegram runtime session bootstrap instead of embedding long-lived secrets.
VITE_ARB_API_TOKEN=

# Optional override. Must match backend ARB_API_TELEGRAM_SESSION_HEADER_NAME when changed.
VITE_ARB_TELEGRAM_SESSION_HEADER_NAME=X-Arb-Telegram-Session
