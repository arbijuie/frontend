{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    }
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b tsconfig.json && vite build --config config/vite.config.ts",
    "lint": "eslint -c config/eslint.config.js .",
    "test:e2e:install": "playwright install chromium",
    "test": "vitest run --config config/vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:local": "node -e \"const {spawnSync}=require('node:child_process'); const env={...process.env, PW_E2E_LOCAL_FALLBACK:'1'}; const r=spawnSync('corepack',['pnpm','exec','playwright','test','--config','playwright.config.ts'],{stdio:'inherit',env,shell:true}); process.exit(r.status ?? 1);\"",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "types:generate": "python ../scripts/export_openapi_schema.py --output src/api/generated/openapi.schema.json && openapi-typescript src/api/generated/openapi.schema.json -o src/api/generated/openapi.ts",
    "types:check": "corepack pnpm run types:generate && git diff --exit-code -- src/api/generated/openapi.schema.json src/api/generated/openapi.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "prepare": "cd .. && husky scripts/git-hooks",
    "audit:ci": "corepack pnpm audit --audit-level high",
    "check": "corepack pnpm run lint && corepack pnpm run test && corepack pnpm run build && corepack pnpm run audit:ci"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
