{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b tsconfig.json && vite build --config config/vite.config.ts",
    "lint": "eslint -c config/eslint.config.js .",
    "test": "vitest run --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "types:generate": "python ../scripts/export_openapi_schema.py --output src/api/generated/openapi.schema.json && openapi-typescript src/api/generated/openapi.schema.json -o src/api/generated/openapi.ts",
    "types:check": "corepack pnpm run types:generate && git diff --exit-code -- src/api/generated/openapi.schema.json src/api/generated/openapi.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "sass-embedded": "^1.102.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "openapi-typescript": "^7.10.1",
    "vite": "^8.2.0",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^30.0.1",
    "@testing-library/react": "^16.3.0"
  }
}
